generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  BILLING_ADMIN
}

enum PlanType {
  FREE
  CREATOR
  ENTERPRISE
  // Self-serve marketing-pricing-page tiers (distinct from the personal
  // CREATOR plan and the sales-assisted ENTERPRISE plan) — see
  // components/marketing/pricing-plans.tsx. Corporate (the third public
  // tier) deliberately has no enum value: it stays "Contact Sales" only,
  // never touches Stripe checkout.
  MID_MARKET
  SMALL_BUSINESS
}

// Which commitment length a MID_MARKET/SMALL_BUSINESS subscriber chose on
// the pricing page — both terms bill monthly (Stripe has no native
// "minimum commitment" concept), the 24-month term is just a lower monthly
// rate. Recorded for visibility/reporting only; this does not enforce any
// early-cancellation penalty.
enum BillingTerm {
  MONTHLY_12
  MONTHLY_24
}

enum SubscriptionStatus {
  INCOMPLETE
  INCOMPLETE_EXPIRED
  TRIALING
  ACTIVE
  PAST_DUE
  UNPAID
  CANCELED
  PAUSED
}

enum BillingOwnerType {
  USER
  ENTERPRISE
}

enum EnterpriseStatus {
  active
  suspended
}

model User {
  id               String     @id @default(cuid())
  name             String
  email            String     @unique
  passwordHash     String
  emailVerified    Boolean    @default(false)
  createdAt        DateTime   @default(now())

  adminRole        AdminRole?
  isSuspended      Boolean    @default(false)
  suspendedAt      DateTime?
  suspensionReason String?
  sessionVersion   Int        @default(1)

  // External HeyGen workspace member ID, for reconciling accounts with
  // HeyGen ahead of a future API integration. Not used for auth.
  heygenUserId     String?

  // Email a payment processor (Stripe) has on file for this person, when it
  // differs from their portal login email. Records a known correspondence
  // without asserting it as the account's identity.
  stripeEmail      String?

  // Raw GoCardless customer ID and whether GoCardless currently reports an
  // active direct-debit mandate for them, from a manual reconciliation pass
  // ahead of a future GoCardless integration. Kept separate from Subscription
  // rather than faked into that (Stripe-shaped, stripeCustomerId-required)
  // table.
  gocardlessCustomerId    String?
  gocardlessMandateActive Boolean @default(false)

  userRoles               UserRole[]
  enterprises             Enterprise[]      @relation("EnterpriseOwner")
  enterpriseMembers       EnterpriseMember[]
  subscriptions           Subscription[]
  avatars                 Avatar[]
  generatedVideos         GeneratedVideo[]
  bookings                Booking[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  invitesSent             Invite[]          @relation("InvitedByUser")
  systemEvents            SystemEvent[]
  emailLogs               EmailLog[]
  adminLogs               AdminLog[]        @relation("AdminUser")
  adminLogsAsTarget       AdminLog[]        @relation("AdminLogTarget")
  bookingNotesAuthored    BookingNote[]
  usageLedgerEntries      UsageLedgerEntry[]

  @@map("users")
}

model Role {
  id                String             @id @default(cuid())
  name              String             @unique
  permissions       RolePermission[]
  userRoles         UserRole[]
  invites           Invite[]
  enterpriseMembers EnterpriseMember[]

  @@map("roles")
}

model Permission {
  id              String           @id @default(cuid())
  name            String           @unique
  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// Phase 1 avatar billing: whether an enterprise's avatars are billed as fully
// independent subscriptions/invoices (default — matches confirmed client
// preference for separate charges) or bundled into one combined subscription.
// Phase 1 always creates one Subscription row per avatar regardless of this
// setting — it's read by the (future) Phase 2 automation to decide how many
// Stripe subscriptions to create, not by anything in Phase 1 itself.
enum AvatarBillingMode {
  SEPARATE
  CONSOLIDATED
}

// Phase 2 avatar billing automation — gates whether Stripe subscription
// writes for this enterprise's avatars happen automatically (self-serve) or
// stay on Phase 1's manual admin path (sales-assisted). Defaults to
// SALES_ASSISTED so every enterprise migrated from Phase 1 is unaffected
// until an admin explicitly flips one.
enum ProvisioningMode {
  SALES_ASSISTED
  SELF_SERVE
}

model Enterprise {
  id                String            @id @default(cuid())
  name              String
  ownerUserId       String
  status            EnterpriseStatus  @default(active)
  suspendedAt       DateTime?
  suspensionReason  String?
  avatarBillingMode AvatarBillingMode @default(SEPARATE)
  provisioningMode  ProvisioningMode  @default(SALES_ASSISTED)
  createdAt         DateTime          @default(now())

  // Raw HeyGen workspace identifier (e.g. "YM502_Concinnity"), preserved
  // alongside the cleaned display name for a future HeyGen integration.
  heygenWorkspaceId String?

  owner         User                @relation("EnterpriseOwner", fields: [ownerUserId], references: [id])
  members       EnterpriseMember[]
  subscriptions Subscription[]
  avatars       Avatar[]
  bookings      Booking[]
  invites       Invite[]
  contacts      EnterpriseContact[]
  systemEvents  SystemEvent[]

  @@index([ownerUserId])
  @@map("enterprises")
}

enum EnterpriseContactType {
  BILLING
  KEY_CONTACT
}

model EnterpriseContact {
  id           String                @id @default(cuid())
  enterpriseId String
  type         EnterpriseContactType
  name         String
  email        String?
  phone        String?
  createdAt    DateTime              @default(now())

  enterprise Enterprise @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)

  @@index([enterpriseId])
  @@map("enterprise_contacts")
}

model EnterpriseMember {
  id           String @id @default(cuid())
  enterpriseId String
  userId       String
  roleId       String

  enterprise Enterprise @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id])

  @@unique([enterpriseId, userId])
  @@map("enterprise_members")
}

enum BillingProvider {
  STRIPE
  GOCARDLESS
}

// Enterprise avatar billing (Phase 1 — data model + manual/admin-driven
// billing, no live Stripe writes). STANDARD is the default so every
// pre-existing row (plan-level subscriptions) is unaffected. PLATFORM_FEE is
// a single row per enterprise; AVATAR_STORAGE is one row per avatar — see the
// @@unique([avatarId]) constraint below.
enum BillingComponent {
  STANDARD
  PLATFORM_FEE
  AVATAR_STORAGE
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String?
  enterpriseId         String?

  ownerType            BillingOwnerType

  // Defaults to STRIPE so every existing row is unaffected. GOCARDLESS rows
  // have stripeCustomerId null and gocardlessCustomerId set instead — kept as
  // two distinct nullable id columns (not one shared "external id" column)
  // so admin UI/webhook code can't accidentally treat a GoCardless id as a
  // Stripe one or vice versa.
  billingProvider      BillingProvider    @default(STRIPE)
  gocardlessCustomerId String?

  // Not unique: a single Stripe customer can legitimately hold more than one
  // concurrent subscription (e.g. a base plan plus a separate seats add-on).
  // stripeSubscriptionId is the real per-subscription identity. Nullable
  // because GOCARDLESS-provider rows never have one.
  stripeCustomerId     String?
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  stripeProductId      String?

  planType             PlanType           @default(FREE)
  status               SubscriptionStatus @default(INCOMPLETE)

  // Only meaningful for MID_MARKET/SMALL_BUSINESS (see BillingTerm's own
  // comment) — null for every other plan type, including pre-existing rows.
  billingTerm          BillingTerm?

  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  canceledAt           DateTime?
  trialEndsAt          DateTime?

  // Enterprise avatar billing (Phase 1). unitAmountCents is nullable and
  // stored per-row rather than derived from one shared constant — per-avatar
  // pricing genuinely varies (confirmed: e.g. two avatars at $99 and a third
  // at $10 on the same enterprise), so this is always an editable value, not
  // a hardcoded default baked into UI copy. null = not yet priced.
  billingComponent     BillingComponent   @default(STANDARD)
  avatarId             String?
  avatar               Avatar?            @relation(fields: [avatarId], references: [id])
  unitAmountCents      Int?
  currency             String             @default("AUD")

  // Phase 2 avatar billing automation — set when a self-serve Stripe
  // provision/cancel call fails, so the row is never silently left unbilled.
  // Cleared on the next successful attempt (initial or retried via the
  // internal cron). Both null on every pre-Phase-2 row.
  provisioningFailedAt   DateTime?
  provisioningFailureMsg String?

  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user                 User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  enterprise           Enterprise?        @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)
  payments             Payment[]
  usageLedgerEntries   UsageLedgerEntry[]

  @@unique([avatarId])
  @@index([userId])
  @@index([enterpriseId])
  @@index([ownerType])
  @@index([status])
  @@index([planType])
  @@index([stripeCustomerId])
  @@index([billingComponent])
  @@map("subscriptions")
}

enum PaymentStatus {
  unpaid
  paid
  refunded
  failed
}

enum PaymentType {
  booking
  subscription
  other
}

model Payment {
  id                    String         @id @default(cuid())
  type      PaymentType       
  stripeInvoiceId       String?        @unique
  stripePaymentIntentId String?        @unique
  amount                Int
  currency              String         @default("aud")

  status                PaymentStatus  @default(unpaid)

  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  // Links to business objects (optional, depending on type)
  bookingId      String?
  subscriptionId String?

  booking      Booking?      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([subscriptionId])
  @@map("payments")
}

enum AvatarBillingStatus {
  ACTIVE
  PAUSED   // temporarily excluded from new billing, data retained
  ARCHIVED // fully decommissioned
}

model Avatar {
  id             String   @id @default(cuid())
  userId         String
  enterpriseId   String?
  // Legacy single-look identifier — still the only HeyGen link for avatars
  // created via the manual admin "Link Avatar" flow (no group/looks
  // involved). For avatars imported in bulk from HeyGen, prefer `looks`;
  // this is left populated with the first look's id purely for back-compat
  // display, not as a source of truth once `looks` is non-empty.
  heygenAvatarId String?
  // HeyGen avatar_group id — the real avatar-identity key. One Avatar row
  // per group, confirmed against the live HeyGen account: a "look" (what
  // heygenAvatarId/AvatarLook.heygenLookId identifies) is a specific
  // outfit/pose variant of the same person, not a distinct avatar. Nullable
  // because manually-linked avatars have no group at all.
  heygenGroupId  String?  @unique
  name           String
  status         String   @default("pending")
  previewUrl     String?
  videoUrl       String?
  metadata       Json?
  createdAt      DateTime @default(now())

  // Phase 1 avatar billing — Name/Phone contact for this specific avatar
  // (distinct from the enterprise-level Billing/Key contacts). Did not exist
  // before this migration — confirmed by reading the live schema first.
  contactName   String?
  contactPhone  String?
  billingStatus AvatarBillingStatus @default(ACTIVE)

  user          User          @relation(fields: [userId], references: [id])
  enterprise    Enterprise?   @relation(fields: [enterpriseId], references: [id])
  subscriptions Subscription[]
  generatedVideos GeneratedVideo[]
  looks         AvatarLook[]

  @@index([userId])
  @@index([enterpriseId])
  @@map("avatars")
}

// One row per HeyGen "look" (a specific outfit/pose/angle variant) that
// belongs to an Avatar identity. Only populated for avatars imported via the
// group-based HeyGen bulk import — manually-linked avatars keep using
// Avatar.heygenAvatarId directly and have no rows here.
model AvatarLook {
  id             String   @id @default(cuid())
  avatarId       String
  heygenLookId   String   @unique
  name           String
  status         String   @default("pending")
  previewUrl     String?
  videoUrl       String?
  defaultVoiceId String?
  createdAt      DateTime @default(now())

  avatar          Avatar           @relation(fields: [avatarId], references: [id], onDelete: Cascade)
  generatedVideos GeneratedVideo[]

  @@index([avatarId])
  @@map("avatar_looks")
}

enum VideoGenerationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// Matches HeyGen's "engine" field on POST /v3/videos (avatar_iii/iv/v).
// Every GeneratedVideo row now records which one was actually requested —
// needed to eventually compute an accurate per-video cost, since HeyGen's
// per-second rate varies ~4x by engine and isn't returned by their video-
// status API. Default AVATAR_IV here backfills existing rows accurately:
// every generation before this field existed was created without an
// explicit engine param, and HeyGen's own default (per their docs) is
// Avatar IV — this is a real historical fact, not a placeholder. The
// application's own default going forward is Avatar III instead (cheaper),
// set at the UI/validation layer, not here.
enum VideoEngine {
  AVATAR_III
  AVATAR_IV
  AVATAR_V
}

// Avatar Studio (v1, script-only): one row per HeyGen video generation job.
// Created synchronously when the job is accepted by HeyGen (status
// PROCESSING, heygenVideoId set from the create response — HeyGen has no
// separate "queued" state before it starts rendering). Completion is
// primarily webhook-driven (see app/api/webhooks/heygen/route.ts); the
// manual status-refresh route re-fetches from HeyGen directly as a fallback
// for whenever the webhook endpoint isn't registered yet or was missed.
model GeneratedVideo {
  id              String                 @id @default(cuid())
  userId          String
  avatarId        String
  script          String
  status          VideoGenerationStatus  @default(PROCESSING)
  engine          VideoEngine            @default(AVATAR_IV)
  heygenVideoId   String?                @unique
  videoUrl        String?
  thumbnailUrl    String?
  errorMessage    String?
  createdAt       DateTime               @default(now())
  completedAt     DateTime?

  // Both populated only once HeyGen reports the video COMPLETED (from its
  // `duration` field, which the video-status API does return, unlike any
  // credit/cost figure — see lib/heygen/pricing.ts). estimatedCostCents is
  // derived (durationSeconds x that engine's $/sec rate), stored rather
  // than computed on every read since the per-engine rate is a point-in-
  // time reference that could change — the estimate as of generation time
  // should stay stable even if lib/heygen/pricing.ts's rates are updated
  // later. Stored in cents matching Payment.amount's existing convention.
  durationSeconds    Float?
  estimatedCostCents Int?

  // Last Heygen-Event-Id whose processing actually completed successfully —
  // HeyGen's docs name this the *primary* replay/redelivery defense (the
  // signature covers the body only, so a captured (body, signature) pair
  // can be replayed with a fresh timestamp without breaking verification).
  // Deliberately records the id only after a successful reconcile, not on
  // receipt, so a retry following a genuine mid-processing failure is still
  // reprocessed rather than skipped.
  lastWebhookEventId String?

  // Which specific look this video was generated with. Nullable — only set
  // for avatars imported from HeyGen (which have looks); avatars linked via
  // the legacy single-avatar admin flow generate directly off
  // Avatar.heygenAvatarId and have no look to record here.
  avatarLookId String?

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatar     Avatar      @relation(fields: [avatarId], references: [id], onDelete: Cascade)
  avatarLook AvatarLook? @relation(fields: [avatarLookId], references: [id], onDelete: SetNull)
  usageLedgerEntries UsageLedgerEntry[]

  @@index([userId])
  @@index([avatarId])
  @@index([avatarLookId])
  @@map("generated_videos")
}

enum UsageLedgerStatus {
  RESERVED   // estimate reserved at generate-time, HeyGen job in flight
  RECONCILED // HeyGen reported COMPLETED; creditsCharged reflects real duration
  RELEASED   // never happened / failed before or during generation; credits given back
}

// Durable per-generation usage record for monthly credit-limit enforcement.
// Deliberately NOT folded into GeneratedVideo (deleting a video must not
// erase what it cost against the user's plan limit) and deliberately NOT
// using the generic SystemEvent table (reserved for admin-facing events,
// not usage metering). Credits are estimated and reserved at generate-time
// (HeyGen never reports a video's duration before it completes, so a limit
// can only actually block "the request that would push someone over" if
// something is charged before that request is sent), then reconciled to
// the real duration once HeyGen reports completion.
model UsageLedgerEntry {
  id             String            @id @default(cuid())
  userId         String
  subscriptionId String?
  // Nullable + SetNull — the one deliberate exception in this schema to
  // Cascade-on-GeneratedVideo, so this row survives video deletion (see
  // app/api/dashboard/videos/[id]/route.ts).
  videoId        String?

  engine VideoEngine
  status UsageLedgerStatus @default(RESERVED)

  estimatedDurationSeconds Float
  // Millicredits (credits x 1000), stored as an integer to avoid floating-
  // point summation drift when totaling many rows against a hard limit —
  // same reasoning as why Payment.amount is integer cents, not a float
  // dollar amount.
  creditsReservedMilli     Int

  // Both populated only once RECONCILED.
  actualDurationSeconds Float?
  creditsChargedMilli   Int?

  // Snapshotted at reservation time rather than derived live from
  // Subscription.currentPeriodStart/End — keeps "sum this period" an exact-
  // match query on a composite index, and keeps history stable even if the
  // subscription's period fields change later for an unrelated reason
  // (plan change, Stripe correction).
  periodStart DateTime
  periodEnd   DateTime

  createdAt    DateTime  @default(now())
  reconciledAt DateTime?
  releasedAt   DateTime?

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription?   @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  video        GeneratedVideo? @relation(fields: [videoId], references: [id], onDelete: SetNull)

  @@index([userId, periodStart, periodEnd])
  @@index([videoId])
  @@map("usage_ledger_entries")
}

enum BookingStatus {
  pending
  confirmed
  cancelled
  completed
}

enum CaptureLocationType {
  capital_city
  regional_other
  multi_location
}

enum AustralianCapitalCity {
  sydney
  melbourne
  brisbane
  perth
  adelaide
  hobart
  canberra
  darwin
}

model Booking {
  id            String   @id @default(cuid())
  userId        String
  enterpriseId  String?
  requestedDate DateTime
  timeStart     String
  timeEnd       String
  capturesCount        Int                  @default(1)
  status               BookingStatus        @default(pending)
  paymentStatus        PaymentStatus        @default(unpaid)
  notes                String?
  captureLocationType  CaptureLocationType?
  capitalCity          AustralianCapitalCity?
  suburbOrTown         String?
  stateOrTerritory     String?
  postcode             String?
  addressLine1         String?
  addressLine2         String?
  locationNotes        String?
  createdAt            DateTime             @default(now())

  user         User        @relation(fields: [userId], references: [id])
  enterprise   Enterprise? @relation(fields: [enterpriseId], references: [id])
  payments     Payment[]
  participants BookingCaptureParticipant[]
  adminNotes   BookingNote[]

  @@index([userId])
  @@index([enterpriseId])
  @@map("bookings")
}

// Internal, admin-only annotations on a booking — distinct from Booking.notes
// (customer-facing, set on the booking form). Append-only: notes are never
// edited or deleted, so this table doubles as its own history/audit trail.
model BookingNote {
  id          String   @id @default(cuid())
  bookingId   String
  adminUserId String
  note        String
  createdAt   DateTime @default(now())

  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  adminUser User    @relation(fields: [adminUserId], references: [id])

  @@index([bookingId])
  @@index([adminUserId])
  @@map("booking_notes")
}

model BookingCaptureParticipant {
  id            String   @id @default(cuid())
  bookingId     String
  sortOrder     Int
  firstName     String
  contactNumber String
  createdAt     DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([bookingId, sortOrder])
  @@index([bookingId])
  @@map("booking_capture_participants")
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

// Same shape as EmailVerificationToken (separate table, not a shared one) —
// keeping the two independent means a reset link and a stale verification
// link can never be confused for one another, and each can carry its own
// expiry policy (this one is shorter-lived: a reset link grants account
// takeover if intercepted, not just an email-ownership check).
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Invite {
  id           String   @id @default(cuid())
  enterpriseId String
  email        String
  roleId       String
  token        String   @unique
  status       String   @default("pending")
  invitedById  String?
  createdAt    DateTime @default(now())

  enterprise Enterprise @relation(fields: [enterpriseId], references: [id])
  role       Role       @relation(fields: [roleId], references: [id])
  invitedBy  User?      @relation("InvitedByUser", fields: [invitedById], references: [id])

  @@index([enterpriseId])
  @@index([roleId])
  @@index([invitedById])
  @@map("invites")
}

model SystemEvent {
  id        String   @id @default(cuid())
  type      String
  source    String
  message   String
  metadata  Json?
  userId    String?
  // Set for enterprise-owned subscriptions/payments (userId stays null in
  // that case) — kept as its own typed relation rather than folding the id
  // into metadata, matching how every other model in this schema stores a
  // real foreign key instead of an id embedded in a JSON blob.
  enterpriseId String?
  createdAt DateTime @default(now())

  user       User?       @relation(fields: [userId], references: [id])
  enterprise Enterprise? @relation(fields: [enterpriseId], references: [id])

  @@index([userId])
  @@index([enterpriseId])
  @@map("system_events")
}

model EmailLog {
  id        String   @id @default(cuid())
  userId    String?
  emailType String
  status    String
  provider  String
  response  Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("email_logs")
}

model Webhook {
  id         String   @id @default(cuid())
  source     String
  eventType  String
  payload    Json
  processed  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@map("webhooks")
}

model AdminLog {
  id           String   @id @default(cuid())
  adminUserId  String
  action       String
  entityType   String
  entityId     String?
  targetUserId String?
  reason       String?
  metadata     Json?
  createdAt    DateTime @default(now())

  adminUser  User  @relation("AdminUser", fields: [adminUserId], references: [id])
  targetUser User? @relation("AdminLogTarget", fields: [targetUserId], references: [id])

  @@index([adminUserId])
  @@index([targetUserId])
  @@map("admin_logs")
}

// Admin sidebar "Quick Links" — a single shared, admin-managed bookmark list
// (not per-user), reorderable via drag-and-drop. `order` is a plain
// ascending sort key rewritten in full on every reorder rather than a
// linked-list/fractional scheme — the list is small (a handful of links),
// so an O(n) rewrite per reorder is simpler and cheap.
model QuickLink {
  id        String   @id @default(cuid())
  label     String
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  // The 4 seeded links (HeyGen, Brevo, Stripe, GoCardless) — protected from
  // deletion (enforced server-side in the DELETE route, not just hidden in
  // the UI) so a stray click can't wipe out the baseline set. Links added
  // afterward default to false and stay freely removable.
  isDefault Boolean  @default(false)

  @@index([order])
  @@map("quick_links")
}

// Fixed-window rate limiting, backed by Postgres rather than Redis since
